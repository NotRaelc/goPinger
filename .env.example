# === Postgres ===
POSTGRES_USER=gopinger
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=gopinger

# === App ===
# Для локального запуска без Docker — задай вручную:
# DATABASE_URL=postgres://gopinger:change_me_strong_password@localhost:5432/gopinger?sslmode=disable
REDIS_URL=redis://redis:6379/0
LISTEN_ADDR=:8080

# auto  — Secure-cookie по r.TLS / X-Forwarded-Proto
# https — всегда Secure (за прокси без X-Forwarded-Proto)
# http  — всегда не-Secure (явный локальный HTTP)
PROTOCOL=auto
TRUST_PROXY=true

# === Планировщик ===
MC_INTERVAL=3m
OTHER_INTERVAL=10s
POLL_TICK=5s
QUERY_TIMEOUT=5s
MAX_QUERY_CONCURRENT=10
MIN_REAL_INTERVAL=5s
LOCK_WAIT_TIMEOUT=3s

# === Лимиты ===
MAX_SERVERS_PER_USER=200
SSE_MAX=10000
PASSWORD_MIN=8

# === Кеш ===
USER_CACHE_TTL=5m
POLL_LOCK_TTL=30s

# === HTTP / прокси ===
HTTP_PORT=8080
DOMAIN=localhost